POSTGRES_DB=csms
POSTGRES_USER=csms
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://csms:change_me@localhost:5432/csms
# Per process: support concurrent periodic reports without reopening DB connections.
DATABASE_POOL_SIZE=20
WALLET_MANUAL_TOPUP_MAX_VND=10000000
WALLET_RECONCILIATION_INTERVAL_SECONDS=300

AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_SECONDS=900
AUTH_SESSION_TTL_SECONDS=86400
AUTH_COOKIE_SECURE=false

OCPP_HEARTBEAT_INTERVAL_SECONDS=60
OCPP_REPLY_CLEANUP_INTERVAL_SECONDS=3600
# Session remains open; mark abnormal after six hours beyond the heartbeat timeout.
CHARGING_ABNORMAL_OFFLINE_SECONDS=21600
CHARGING_RECOVERY_SCAN_INTERVAL_SECONDS=60

# T-104: kWh times highest effective tariff rate; reserve only without a tariff.
CHARGING_MINIMUM_KWH=5
WALLET_RESERVE_VND=10000

# S-26: local-only account used by the Compose verifier to read simulator status.
SIMULATOR_OPERATOR_PASSWORD=change_me
# S-26: Compose pins the image/library versions from K-01; override only together.
SIMULATOR_OCPP_VERSION=2.1.0
SIMULATOR_WEBSOCKETS_VERSION=15.0.1

# T-90: disabled by default. Set fake only for local/test; sandbox is S-67.
PAYMENT_GATEWAY=disabled
# Generate a private key locally; never commit an actual webhook secret.
PAYMENT_WEBHOOK_SECRET=
PAYMENT_RETURN_URL=http://localhost:5173/wallet/topup/return
PAYMENT_FAKE_BASE_URL=http://localhost:8000

# T-93: inclusive server-side limits, integer VND.
WALLET_TOPUP_MIN_VND=10000
WALLET_TOPUP_MAX_VND=5000000
