POSTGRES_DB=csms
POSTGRES_USER=csms
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://csms:change_me@localhost:5432/csms

# G3: liveness deadline (2 heartbeats) plus this grace, and distinct stored errors.
ALERT_OFFLINE_GRACE_SECONDS=300
ALERT_ERROR_THRESHOLD=3
ALERT_ERROR_WINDOW_SECONDS=600
ALERT_SCAN_INTERVAL_SECONDS=15
# Disabled until recipients and a trusted SMTP server are explicitly configured.
# Shared transport: blank preserves the complete legacy ALERT_SMTP_* profile.
# Set true to send domain emails independently of operational-alert recipients.
SMTP_ENABLED=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=5
# Operational-alert email switch and recipient list remain separate.
ALERT_SMTP_ENABLED=false
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_SECURITY=starttls
ALERT_SMTP_FROM=
ALERT_EMAIL_RECIPIENTS=[]
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_TIMEOUT_SECONDS=5
ALERT_EMAIL_MAX_ATTEMPTS=6
# Enable for the bundled simulator or a verified fleet where Available proves unplug.
# A session captures this setting at StartTransaction; changing it is not retroactive.
BILLING_AVAILABLE_CONFIRMS_UNPLUG=false
# Demo only: requires Available to prove unplug and a DEMO-STG-* charger.
DEMO_DRIVER_UNPLUG_ENABLED=false
# Per process: support concurrent periodic reports without reopening DB connections.
DATABASE_POOL_SIZE=20
WALLET_MANUAL_TOPUP_MAX_VND=10000000
WALLET_RECONCILIATION_INTERVAL_SECONDS=300

AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_SECONDS=900
AUTH_SESSION_TTL_SECONDS=86400
AUTH_COOKIE_SECURE=false

OCPP_HEARTBEAT_INTERVAL_SECONDS=60
OCPP_REPLY_CLEANUP_INTERVAL_SECONDS=3600
# Session remains open; mark abnormal after six hours beyond the heartbeat timeout.
CHARGING_ABNORMAL_OFFLINE_SECONDS=21600
CHARGING_RECOVERY_SCAN_INTERVAL_SECONDS=60

# T-104: kWh times highest effective tariff rate; reserve only without a tariff.
CHARGING_MINIMUM_KWH=5
WALLET_RESERVE_VND=10000

# S-26: local-only account used by the Compose verifier to read simulator status.
SIMULATOR_OPERATOR_PASSWORD=change_me
# S-26: Compose pins the image/library versions from K-01; override only together.
SIMULATOR_OCPP_VERSION=2.1.0
SIMULATOR_WEBSOCKETS_VERSION=15.0.1

# S-35: disabled by default; fake is local/test, sandbox is VNPAY PAY 2.1.0.
PAYMENT_GATEWAY=disabled
# Generate a private key locally; never commit an actual webhook secret.
PAYMENT_WEBHOOK_SECRET=
PAYMENT_RETURN_URL=http://localhost:5173/wallet/topup/return
PAYMENT_FAKE_BASE_URL=http://localhost:8000
# For sandbox, PAYMENT_WEBHOOK_SECRET is the VNPAY HashSecret (backend only).
VNPAY_TMN_CODE=
# Public IP of the server issuing QueryDR; empty disables administrator queries.
VNPAY_QUERY_IP=
VNPAY_RETURN_URL=https://csms-staging.daominhtam2k6.id.vn/api/v1/payments/vnpay/return
VNPAY_EXPIRY_MINUTES=15
# PAYMENT_RETURN_URL must be the HTTPS frontend /wallet/topup/return in staging.
# AUTH_COOKIE_SECURE=true in HTTPS staging.

# T-93: inclusive server-side limits, integer VND.
WALLET_TOPUP_MIN_VND=10000
WALLET_TOPUP_MAX_VND=5000000

# S-42..44: timeout for each SmartCharging command; range 0.1..30 seconds.
POWER_COMMAND_TIMEOUT_SECONDS=5
# S-48/S-51: reservation command response timeout, in seconds (0 < value <= 30).
RESERVATION_COMMAND_TIMEOUT_SECONDS=5
